# Required: shared token the app sends as "Authorization: Bearer <token>" (min 24 chars).
# Generate: bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
API_TOKEN=
PORT=3000
DB_PATH=data/preco-vivo.db
# Origins allowed to call /api (web dev server and the Android WebView).
CORS_ORIGINS=http://localhost:5173,https://localhost
# Serve the built web app from the same server (optional in dev).
WEB_DIST=
# Optional: OpenAI-compatible gateway (LiteLLM) to judge product merge suggestions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=cloud/llama-8b
